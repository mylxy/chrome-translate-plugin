{
  "manifest_version": 3,
  "name": "DeepSeek 划词翻译",
  "version": "0.1.0",
  "description": "选中非中文文本后，使用 DeepSeek Flash 显示紧凑翻译气泡。",
  "icons": {
    "16": "icons/deepseek-whale-16.png",
    "32": "icons/deepseek-whale-32.png",
    "48": "icons/deepseek-whale-48.png",
    "128": "icons/deepseek-whale-128.png"
  },
  "permissions": ["storage", "tts"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/index.html",
  "action": {
    "default_title": "DeepSeek 划词翻译",
    "default_icon": {
      "16": "icons/deepseek-whale-16.png",
      "32": "icons/deepseek-whale-32.png",
      "48": "icons/deepseek-whale-48.png",
      "128": "icons/deepseek-whale-128.png"
    },
    "default_popup": "src/options/index.html"
  }
}
